/target/
!/Cargo.lock
/out/
/web/node_modules/
/web/dist/
/web/test-results/

# Source artwork may include authoring metadata. The public bird is in web/src/assets/.
/assets/

# A workload initialized in the checkout is local to its author.
/starling.yaml
/starling.yml
/starling.toml

# Only the built-in fixture workloads belong in Git.
/examples/*
!/examples/local.toml
!/examples/local.yaml
